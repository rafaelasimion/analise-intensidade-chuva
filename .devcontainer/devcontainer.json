{
  "name": "Chuva e balanço hídrico (React + FastAPI)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "src/App.jsx", "api/index.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "dbaeumer.vscode-eslint"]
    }
  },
  "postCreateCommand": "pip3 install --user -r requirements-dev.txt && npm install",
  "postAttachCommand": {
    "server": "npm run dev"
  },
  "portsAttributes": {
    "5173": { "label": "Site (Vite)", "onAutoForward": "openPreview" },
    "8000": { "label": "API (FastAPI)" }
  },
  "forwardPorts": [5173, 8000]
}
